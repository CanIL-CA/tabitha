{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "www",
	"compatibility_date": "2026-09-20",
	"compatibility_flags": [
		"nodejs_compat"
	],
	"main": ".svelte-kit/cloudflare/_worker.js",
	"assets": {
		"binding": "ASSETS",
		"directory": ".svelte-kit/cloudflare"
	},
	"workers_dev": false,
	"observability": {
		"enabled": true,
		"head_sampling_rate": 1
	},
	"routes": [
		{
			"pattern": "tabitha.bible",
			"custom_domain": true
		},
		// Preview-only domain for per-PR Previews at pr-<N>.www-pr.tabitha.bible (see the previews
		// block below). Declared here because every wrangler deploy resets this Worker's custom
		// domains to match this file.
		{
			"pattern": "www-pr.tabitha.bible",
			"custom_domain": true,
			"previews_enabled": true,
			"enabled": false
		}
	],
	// Per-PR Worker Previews, served at `pr-<N>.www-pr.tabitha.bible`. CI's preview_deploy job creates
	// them with `wrangler preview --name pr-<N>` (docs/decisions/0020-per-pr-worker-previews.md).
	// A Preview inherits nothing from the top level, so every var and binding it needs is redeclared.
	// Production lives on the apex (tabitha.bible), so Previews get their own preview-only custom
	// domain, www-pr.tabitha.bible, instead of a *.tabitha.bible wildcard on the apex
	// (www.tabitha.bible is taken by a DNS record that redirects to the apex). This Worker has no
	// vars or bindings, so the block is empty, but Wrangler requires it to exist.
	"previews": {}
}
