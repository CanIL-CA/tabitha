{
	"name": "@tabitha/www",
	"version": "1.0.0",
	"private": true,
	"type": "module",
	"scripts": {
		"prepare": "svelte-kit sync",
		"check": "bun run prepare && bun run check:svelte",
		"check:svelte": "svelte-check --tsconfig ./tsconfig.json",
		"check:lint": "eslint .",
		"check:lint:fix": "eslint . --fix",
		"build": "bun run clean:adapter && vite build",
		"build:preview": "bun run clean:adapter && bun run --bun vite build",
		"deploy:preview": "bun run build:preview && bunx wrangler preview",
		"dev": "vite dev",
		"dev:e2e": "vite dev",
		"test": "bun run test:e2e",
		"test:e2e": "playwright test",
		"test:e2e:dev": "playwright test --ui",
		"precommit": "bun run check && bun run check:lint && bun run build && bun run test",
		"clean:adapter": "rm -rf .svelte-kit/cloudflare .svelte-kit/cloudflare-tmp",
		"clean:svelte": "rm -rf .svelte-kit",
		"clean:deps": "rm -rf node_modules",
		"clean:powerwash": "(bun run clean:svelte & bun run clean:deps) && bun install"
	},
	"dependencies": {
		"@sveltejs/kit": "^2.70.3",
		"@tabitha/api-client": "workspace:*",
		"@tabitha/types": "workspace:*",
		"@tabitha/ui": "workspace:*",
		"@tailwindcss/typography": "^0.5.20",
		"daisyui": "^5.7.42",
		"svelte": "^5.57.1",
		"tailwindcss": "^4.3.3"
	},
	"devDependencies": {
		"@eslint/compat": "^2.1.1",
		"@playwright/test": "^1.63.0",
		"@sveltejs/adapter-cloudflare": "^7.2.9",
		"@sveltejs/vite-plugin-svelte": "^7.3.0",
		"@tabitha/eslint-config": "workspace:*",
		"@tabitha/vite-config": "workspace:*",
		"@tailwindcss/vite": "^4.3.3",
		"eslint": "^10.11.0",
		"svelte-check": "^4.7.6",
		"typescript": "^6.0.3",
		"vite": "8.2.0",
		"wrangler": "^4.135.0"
	}
}
