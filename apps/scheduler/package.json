{
	"name": "@tabitha/scheduler",
	"version": "1.0.0",
	"private": true,
	"type": "module",
	"description": "Cron-only Cloudflare Worker that triggers each app's scheduled work through a service binding (ADR 0018)",
	"scripts": {
		"check": "tsc --noEmit",
		"check:lint": "eslint .",
		"check:lint:fix": "eslint . --fix",
		"build": "wrangler deploy --dry-run --outdir dist",
		"build:ci": "bun run build",
		"dev": "wrangler dev --test-scheduled",
		"test": "bun run test:unit",
		"test:unit": "vitest run src",
		"precommit": "bun run check && bun run check:lint && bun run build && bun run test"
	},
	"devDependencies": {
		"@cloudflare/workers-types": "^5.20260920.1",
		"@tabitha/eslint-config": "workspace:*",
		"@tabitha/tsconfig": "workspace:*",
		"eslint": "^10.11.0",
		"typescript": "^6.0.3",
		"vitest": "^5.0.3",
		"wrangler": "^4.135.0"
	}
}
