{
	"$schema": "https://v2-10-11.turborepo.dev/schema.json",
	"extends": ["//"],
	"tasks": {
		"build": {
			"inputs": ["src/**", "scripts/**", "package.json", "tsconfig.json", "wrangler.jsonc"],
			"outputs": ["dist/**", "engine/**"]
		},
		"build:ci": {
			"inputs": ["src/**", "scripts/**", "package.json", "tsconfig.json", "wrangler.jsonc"],
			"outputs": ["dist/**", "engine/**"]
		}
	}
}
