{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "generator",
	"main": "src/index.ts",
	"compatibility_date": "2026-10-06",
	// Called by the other apps through a service binding, never from a browser.
	"workers_dev": false,
	"observability": {
		"enabled": true,
		"head_sampling_rate": 1
	},
	// Browsers that run the engine themselves download its files from here, through sources (GET /files/*).
	"assets": {
		"directory": "./engine",
		"binding": "ASSETS",
		"run_worker_first": true
	},
	"rules": [
		// The engine's databases, prepared by tools/tbta-wasm, are bundled as raw bytes.
		{ "type": "Data", "globs": ["**/*.sqlite"] }
	]
}
