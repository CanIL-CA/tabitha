{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "generator",
	"main": "src/index.ts",
	"compatibility_date": "2026-10-06",
	// Called by the other apps through a service binding, never from a browser.
	"workers_dev": false,
	// PORTS.generator in @tabitha/vite-config/ports. Sources' binding finds it through wrangler's
	// dev registry, not the port; pinning it keeps it off 8787, which the scheduler uses.
	"dev": {
		"port": 1966
	},
	"observability": {
		"enabled": true,
		"head_sampling_rate": 1,
		"issues": {
			"enabled": true
		}
	},
	// Browsers that run the engine themselves download its files from here, through sources (GET /files/*).
	"assets": {
		"directory": "./engine",
		"binding": "ASSETS",
		"run_worker_first": true
	},
	"rules": [
		// The engine's databases, downloaded by scripts/fetch_engine.ts, are bundled as raw bytes.
		{ "type": "Data", "globs": ["**/*.sqlite"] }
	]
}
