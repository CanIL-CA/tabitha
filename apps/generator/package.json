{
	"name": "@tabitha/generator",
	"version": "1.0.0",
	"private": true,
	"type": "module",
	"description": "Generates verse text from a semantic encoding with TBTA's engine compiled to WebAssembly",
	"imports": {
		"#engine/*": "./engine/*"
	},
	"exports": {
		"./engine": "./src/engine.ts",
		"./engine_source": "./scripts/engine_source.ts"
	},
	"scripts": {
		"check": "bun --check",
		"check:lint": "eslint .",
		"check:lint:fix": "eslint . --fix",
		"engine:fetch": "bun scripts/fetch_engine.ts",
		"data:prune": "bun scripts/prune_data.ts",
		"build": "bun run engine:fetch && wrangler deploy --dry-run --outdir dist",
		"build:ci": "bun run build",
		"dev": "bun run engine:fetch && wrangler dev",
		"test": "bun run test:unit",
		"test:unit": "vitest run src && bun test scripts"
	},
	"devDependencies": {
		"@cloudflare/workers-types": "^5.20261119.1",
		"@tabitha/eslint-config": "workspace:*",
		"@tabitha/tsconfig": "workspace:*",
		"@types/bun": "^1.4.4",
		"eslint": "^10.15.0",
		"typescript": "^6.0.3",
		"vitest": "^5.1.1",
		"wrangler": "^4.165.0"
	}
}
