{
	"name": "@tabitha/generator",
	"version": "1.0.0",
	"private": true,
	"type": "module",
	"description": "Proof of concept: generates verse text from a semantic encoding with TBTA's engine compiled to WebAssembly",
	"imports": {
		"#engine/*": "./engine/*"
	},
	"exports": {
		"./engine": "./src/engine.ts"
	},
	"scripts": {
		"check": "bun --check",
		"check:lint": "eslint .",
		"check:lint:fix": "eslint . --fix",
		"bundle": "wrangler deploy --dry-run --outdir dist",
		"deploy": "wrangler deploy",
		"dev": "wrangler dev"
	},
	"devDependencies": {
		"@cloudflare/workers-types": "^5.20261029.1",
		"@tabitha/eslint-config": "workspace:*",
		"@tabitha/tsconfig": "workspace:*",
		"eslint": "^10.14.0",
		"typescript": "^6.0.3",
		"wrangler": "^4.156.0"
	}
}
