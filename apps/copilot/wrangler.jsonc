{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "copilot",
	"compatibility_date": "2026-09-20",
	"compatibility_flags": [
		"nodejs_compat"
	],
	"vars": {
		"CLOUDFLARE_ACCOUNT_ID": "8582954a9e4c6f0259c6236be794d7d3",
		"GEMINI_PROJECT_ID": "gen-lang-client-0319586327",
		"GEMINI_LOCATION": "global"
	},
	// Anonymous feature-usage events -- see docs/decisions/0017-usage-analytics-engine.md for the
	// schema and example queries.
	"analytics_engine_datasets": [
		{
			"binding": "USAGE",
			"dataset": "tabitha_usage"
		}
	],
	"placement": {
		// No D1 database here (unlike editor/ontology/sources/targets, which need edge proximity
		// to the user for D1 withSession() bookmarking) -- copilot's request-time cost is the
		// external Vertex AI/Gemini call in brief.ts, so Smart Placement colocating the Worker
		// near that backend is the right tradeoff instead.
		"mode": "smart"
	},
	"ratelimits": [
		{
			"name": "RATE_LIMITER",
			"namespace_id": "4",
			"simple": {
				"limit": 60,
				"period": 60
			}
		}
	],
	"main": ".svelte-kit/cloudflare/_worker.js",
	"assets": {
		"binding": "ASSETS",
		"directory": ".svelte-kit/cloudflare"
	},
	"workers_dev": false,
	"routes": [
		{
			"pattern": "copilot.tabitha.bible",
			"custom_domain": true
		}
	],
	"observability": {
		"logs": {
			"enabled": true,
			"invocation_logs": true
		}
	},
	// Per-PR Worker Previews, served at `pr-<N>.copilot.tabitha.bible`. CI's preview_deploy job creates
	// them with `wrangler preview --name pr-<N>` (docs/decisions/0020-per-pr-worker-previews.md).
	// A Preview inherits nothing from the top level, so every var and binding it needs is redeclared.
	"previews": {
		// "analytics_engine_datasets" is intentionally left undeclared: usage is only tracked in
		// production, and recording is a no-op without the binding.
		"vars": {
			"CLOUDFLARE_ACCOUNT_ID": "8582954a9e4c6f0259c6236be794d7d3",
			"GEMINI_PROJECT_ID": "gen-lang-client-0319586327",
			"GEMINI_LOCATION": "global"
		},
		"ratelimits": [
			{
				"name": "RATE_LIMITER",
				"namespace_id": "4",
				"simple": {
					"limit": 60,
					"period": 60
				}
			}
		]
	}
}
