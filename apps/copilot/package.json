{
  "name": "@tabitha/copilot",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "prepare": "svelte-kit sync",
    "check": "bun run prepare && tabitha-compile-messages && bun run check:svelte",
    "check:svelte": "svelte-check --tsconfig ./tsconfig.json",
    "check:lint": "eslint .",
    "check:lint:fix": "eslint . --fix",
    "build": "vite build",
    "build:ci": "bun run --bun vite build",
    "build:preview": "bun run --bun vite build",
    "deploy:preview": "bun run build:preview && bunx wrangler preview",
    "dev": "vite dev",
    "dev:e2e": "NODE_OPTIONS=\"$NODE_OPTIONS --import ./e2e/support/mock_ai_gateway.mjs\" vite dev",
    "preview": "wrangler dev .svelte-kit/cloudflare/_worker.js --port 4173",
    "test": "bun run test:unit && bun run test:e2e",
    "test:unit": "vitest run src",
    "test:unit:watch": "vitest watch",
    "test:e2e": "playwright test",
    "test:e2e:dev": "playwright test --ui",
    "gen": "wrangler types",
    "precommit": "bun run check && bun run check:lint && bun run build && bun run test",
    "clean:svelte": "rm -rf .svelte-kit",
    "clean:deps": "rm -rf node_modules",
    "clean:powerwash": "(bun run clean:svelte & bun run clean:deps) && bun install"
  },
  "dependencies": {
    "@sveltejs/kit": "^2.70.3",
    "@tabitha/ai": "workspace:*",
    "@tabitha/api-client": "workspace:*",
    "@tabitha/cors": "workspace:*",
    "@tabitha/noindex": "workspace:*",
    "@tabitha/rate-limit": "workspace:*",
    "@tabitha/types": "workspace:*",
    "@tabitha/ui": "workspace:*",
    "@tabitha/usage": "workspace:*",
    "@tailwindcss/typography": "^0.5.20",
    "daisyui": "^5.7.42",
    "svelte": "^5.57.1",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@eslint/compat": "^2.1.1",
    "@fontsource/fira-mono": "^5.3.0",
    "@iconify/svelte": "^5.2.2",
    "@neoconfetti/svelte": "^2.2.2",
    "@playwright/test": "^1.63.0",
    "@sveltejs/adapter-cloudflare": "^7.2.9",
    "@sveltejs/vite-plugin-svelte": "^7.3.0",
    "@tabitha/eslint-config": "workspace:*",
    "@tabitha/vite-config": "workspace:*",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.2",
    "eslint": "^10.11.0",
    "playwright": "^1.63.0",
    "postcss": "^8.5.28",
    "svelte-check": "^4.7.6",
    "typescript": "^6.0.3",
    "vite": "8.2.0",
    "vitest": "^5.0.3",
    "wrangler": "^4.135.0"
  }
}