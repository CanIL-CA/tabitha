{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "editor",
	"compatibility_date": "2026-10-06",
	"compatibility_flags": [
		"nodejs_compat"
	],
	"main": ".svelte-kit/cloudflare/_worker.js",
	"assets": {
		"binding": "ASSETS",
		"directory": ".svelte-kit/cloudflare"
	},
	"workers_dev": false,
	"observability": {
		"enabled": true,
		"head_sampling_rate": 1
	},
	"vars": {
		"CLOUDFLARE_ACCOUNT_ID": "8582954a9e4c6f0259c6236be794d7d3",
		"GEMINI_PROJECT_ID": "gen-lang-client-0319586327",
		"GEMINI_LOCATION": "global"
	},
	"routes": [
		{
			"pattern": "editor.tabitha.bible",
			"custom_domain": true,
			// Also serves per-PR Previews at pr-<N>.editor.tabitha.bible (ADR 0020). Declared here
			// because every wrangler deploy resets the domain's settings to match this file.
			"previews_enabled": true
		}
	],
	"ratelimits": [
		{
			"name": "RATE_LIMITER",
			"namespace_id": "5",
			"simple": {
				"limit": 60,
				"period": 60
			}
		}
	],
	// Anonymous feature-usage events -- see docs/decisions/0017-usage-analytics-engine.md for the
	// schema and example queries.
	"analytics_engine_datasets": [
		{
			"binding": "USAGE",
			"dataset": "tabitha_usage"
		}
	],
	"placement": {
		// Necessary to support edge proximity routing
		// https://developers.cloudflare.com/d1/concepts/sessions/
		"mode": "off"
	},
	// Per-PR Worker Previews, served at `pr-<N>.editor.tabitha.bible`. CI's preview_deploy job creates
	// them with `wrangler preview --name pr-<N>` (docs/decisions/0020-per-pr-worker-previews.md).
	// A Preview inherits nothing from the top level, so every var and binding it needs is redeclared.
	"previews": {
		// "analytics_engine_datasets" is intentionally left undeclared: usage is only tracked in
		// production, and recording is a no-op without the binding.
		"vars": {
			"CLOUDFLARE_ACCOUNT_ID": "8582954a9e4c6f0259c6236be794d7d3",
			"GEMINI_PROJECT_ID": "gen-lang-client-0319586327",
			"GEMINI_LOCATION": "global"
		},
		"ratelimits": [
			{
				"name": "RATE_LIMITER",
				"namespace_id": "5",
				"simple": {
					"limit": 60,
					"period": 60
				}
			}
		]
	}
}
