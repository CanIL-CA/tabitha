# ══════════════════════════════════════════════════════════════════════════
# OPEN CONFIG
# Real values, safe to commit. May be public (client-exposed) or private
# (server-only) -- see the $app/env/... tag on each line for which SvelteKit
# module to import it from. Cloudflare: belongs in wrangler.jsonc's `vars`
# block for real deployments, not a `wrangler secret`.
# ══════════════════════════════════════════════════════════════════════════

# $app/env/public (static) -- a sibling app's API host, safe for client code to call directly
PUBLIC_ONTOLOGY_API_HOST=https://ontology.tabitha.bible
PUBLIC_TARGETS_API_HOST=https://targets.tabitha.bible
PUBLIC_EDITOR_API_HOST=https://editor.tabitha.bible

# $app/env/public (static) -- blank is the correct production value ("off") -- scripts/dx/setup_env.ts
# sets this to `true` only in .env.local, so local dev alone gets cross-origin access
PUBLIC_CORS_ALLOW_LOCALHOST=

# $app/env/public (static) -- blank means rate limiting stays enforced, the correct production
# value -- scripts/dx/setup_env.ts sets this to `true` only in .env.local, since a real
# e2e/dev session's fast request bursts would otherwise trip the same threshold meant for
# real-world abuse
PUBLIC_RATE_LIMIT_DISABLED=

# $app/env/public (static) -- blank means server-side calls to sibling apps go through service
# bindings, the correct production value -- scripts/dx/setup_env.ts sets this to `true` only in
# .env.local, since sibling apps run under `vite dev` locally, which a binding can't reach
PUBLIC_SERVICE_BINDINGS_DISABLED=

# $app/env/private (static) -- not secret, but the real value only applies to genuine Cloudflare
# deployments (prod & per-PR Previews) -- scripts/dx/setup_env.ts forces this blank in .env.local
# so local dev signs in through its own Google client instead of Better Auth's OAuth proxy
OAUTH_REDIRECT_PROXY_URL=https://sources.tabitha.bible

# $app/env/private (static) -- not secret; every app's session cookie is set on this domain, so
# signing in to one tabitha.bible app signs in to all of them (docs/decisions/0027) --
# scripts/dx/setup_env.ts forces this blank in .env.local, where a localhost cookie reaches every app
AUTH_COOKIE_DOMAIN=tabitha.bible

# $app/env/private (static) -- not secret, also replicated in wrangler.jsonc's `vars` for real
# deployments -- the "TaBiThA (prod)" client every app shares -- https://console.cloud.google.com/auth/clients
GOOGLE_OAUTH_CLIENT_ID=839335496347-0tb9fcocvv3gcvr9d4derj2l76uirgab.apps.googleusercontent.com

# ══════════════════════════════════════════════════════════════════════════
# SECRETS
# Left blank here; real values live only in .env.local (gitignored) or the
# deployment's own secret store. Still tagged with the SvelteKit module
# they're read through. Cloudflare: set via `wrangler secret put <NAME>`
# (or the dashboard), never in wrangler.jsonc `vars` --
# scripts/audits/check_cloudflare.ts enforces this.
# ══════════════════════════════════════════════════════════════════════════

# $app/env/private (static) -- `bun run setup:env` generates a local one; production and Previews share one random
# value -- https://www.better-auth.com/docs/installation#set-environment-variables
BETTER_AUTH_SECRET=

# $app/env/private (static) -- https://console.cloud.google.com/auth/clients
GOOGLE_OAUTH_CLIENT_SECRET=
