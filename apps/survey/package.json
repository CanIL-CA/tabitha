{
  "name": "@tabitha/survey",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "imports": {
    "#lib/*": "./src/lib/*"
  },
  "scripts": {
    "prepare": "svelte-kit sync",
    "check": "bun run prepare && bun run check:svelte",
    "check:svelte": "svelte-check --tsconfig ./tsconfig.json",
    "check:lint": "eslint .",
    "check:lint:fix": "eslint . --fix",
    "build": "vite build",
    "build:ci": "bun run --bun vite build",
    "dev": "vite dev",
    "test": "bun run test:unit",
    "test:unit": "vitest run src",
    "test:unit:watch": "vitest watch",
    "test:unit:coverage": "vitest run --coverage",
    "precommit": "bun run check && bun run check:lint && bun run build && bun run test",
    "publish": "bun scripts/publish.ts",
    "clean:svelte": "rm -rf .svelte-kit",
    "clean:deps": "rm -rf node_modules",
    "clean:powerwash": "(bun run clean:svelte & bun run clean:deps) && bun install"
  },
  "dependencies": {
    "@tabitha/noindex": "workspace:*",
    "@tabitha/rate-limit": "workspace:*",
    "@tabitha/types": "workspace:*",
    "@tabitha/ui": "workspace:*",
    "@tailwindcss/typography": "^0.5.20",
    "daisyui": "^5.7.47",
    "svelte": "^5.57.2",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261019.1",
    "@eslint/compat": "^2.1.1",
    "@iconify/svelte": "^5.2.2",
    "@sveltejs/adapter-cloudflare": "^8.0.1",
    "@sveltejs/kit": "^3.1.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tabitha/eslint-config": "workspace:*",
    "@tabitha/tsconfig": "workspace:*",
    "@tabitha/vite-config": "workspace:*",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.5",
    "@vitest/coverage-v8": "^5.0.5",
    "eslint": "^10.12.0",
    "postcss": "^8.5.31",
    "svelte-check": "^4.7.7",
    "typescript": "^6.0.3",
    "vite": "8.3.4",
    "vitest": "^5.0.5",
    "wrangler": "^4.151.3"
  }
}
