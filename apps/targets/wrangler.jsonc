{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "targets",
	"compatibility_date": "2026-09-20",
	"compatibility_flags": [
		"nodejs_compat"
	],
	"main": ".svelte-kit/cloudflare/_worker.js",
	"assets": {
		"binding": "ASSETS",
		"directory": ".svelte-kit/cloudflare"
	},
	"workers_dev": false,
	"observability": {
		"enabled": true,
		"head_sampling_rate": 1
	},
	"routes": [
		{
			"pattern": "targets.tabitha.bible",
			"custom_domain": true,
			// Also serves per-PR Previews at pr-<N>.targets.tabitha.bible (ADR 0020). Declared here
			// because every wrangler deploy resets the domain's settings to match this file.
			"previews_enabled": true
		}
	],
	"ratelimits": [
		{
			"name": "RATE_LIMITER",
			"namespace_id": "3",
			"simple": {
				"limit": 60,
				"period": 60
			}
		}
	],
	// One D1 database per target-language project (docs/decisions/0012-per-project-targets-databases.md).
	// Binding names must match TARGET_PROJECTS in @tabitha/types/target. database_name follows the
	// same "<Task>_<date>" convention as Sources/Ontology (each migration run mints a fresh dated
	// database rather than updating in place).
	"d1_databases": [
		{
			"binding": "DB_Targets_English",
			"database_name": "Targets_English_2026-07-31",
			"database_id": "fa05d7a0-3241-465f-b47a-80898f86c1a9"
		},
		{
			"binding": "DB_Targets_Swahili",
			"database_name": "Targets_Swahili_2026-07-31",
			"database_id": "ef94ce5e-a99c-40c2-ab55-402d17bf4326"
		},
		{
			"binding": "DB_Targets_Indonesian",
			"database_name": "Targets_Indonesian_2026-10-06",
			"database_id": "3d2efd35-291a-46df-a349-f1965898a0aa"
		},
		{
			"binding": "DB_Targets_Tagalog",
			"database_name": "Targets_Tagalog_2026-07-31",
			"database_id": "8c9b556c-c434-48d3-a8bc-a2b48f336328"
		}
	],
	// Anonymous feature-usage events -- see docs/decisions/0017-usage-analytics-engine.md for the
	// schema and example queries.
	"analytics_engine_datasets": [
		{
			"binding": "USAGE",
			"dataset": "tabitha_usage"
		}
	],
	"placement": {
		// Necessary to support D1 withSession() bookmarking and edge proximity routing
		// https://developers.cloudflare.com/d1/concepts/sessions/
		"mode": "off"
	},
	// Per-PR Worker Previews, served at `pr-<N>.targets.tabitha.bible`. CI's preview_deploy job creates
	// them with `wrangler preview --name pr-<N>` (docs/decisions/0020-per-pr-worker-previews.md).
	// A Preview inherits nothing from the top level, so every var and binding it needs is redeclared.
	"previews": {
		// "analytics_engine_datasets" is intentionally left undeclared: usage is only tracked in
		// production, and recording is a no-op without the binding.
		"ratelimits": [
			{
				"name": "RATE_LIMITER",
				"namespace_id": "3",
				"simple": {
					"limit": 60,
					"period": 60
				}
			}
		],
		"d1_databases": [
			{
				"binding": "DB_Targets_English",
				"database_name": "Targets_English_2026-07-31",
				"database_id": "fa05d7a0-3241-465f-b47a-80898f86c1a9"
			},
			{
				"binding": "DB_Targets_Swahili",
				"database_name": "Targets_Swahili_2026-07-31",
				"database_id": "ef94ce5e-a99c-40c2-ab55-402d17bf4326"
			},
			{
				"binding": "DB_Targets_Indonesian",
				"database_name": "Targets_Indonesian_2026-10-06",
				"database_id": "3d2efd35-291a-46df-a349-f1965898a0aa"
			},
			{
				"binding": "DB_Targets_Tagalog",
				"database_name": "Targets_Tagalog_2026-07-31",
				"database_id": "8c9b556c-c434-48d3-a8bc-a2b48f336328"
			}
		]
	}
}
