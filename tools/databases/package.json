{
  "name": "@tabitha/databases",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Tabitha SQLite databases, ETL migrations, and dump utilities",
  "scripts": {
    "check": "tsc --noEmit",
    "check:lint": "eslint .",
    "check:lint:fix": "eslint . --fix",
    "test": "bun run test:unit",
    "test:unit": "LOG_LEVEL=quiet bun test migrations",
    "migrate": "bun migrations/orchestrator.ts",
    "migrate:auth": "bun migrations/auth/create.ts",
    "migrate:ontology": "bun migrations/ontology/migrate.ts",
    "migrate:sources": "bun migrations/sources/migrate.ts",
    "migrate:targets": "bun migrations/targets/migrate.ts",
    "migrate:status": "bun migrations/sources/update_status.ts",
    "r2:pull": "bun migrations/r2_sync.ts pull",
    "r2:push": "bun migrations/r2_sync.ts push",
    "r2:prune": "bun migrations/r2_sync.ts prune",
    "cleanup:d1": "bun migrations/cleanup_unused_d1.ts",
    "cleanup:backups": "bun migrations/cleanup_old_backups.ts"
  },
  "dependencies": {
    "@tabitha/complex-terms": "workspace:*",
    "adm-zip": "^0.6.1",
    "officeparser": "^8.1.1"
  },
  "devDependencies": {
    "@tabitha/eslint-config": "workspace:*",
    "@tabitha/tsconfig": "workspace:*",
    "@tabitha/types": "workspace:*",
    "@types/bun": "^1.4.2",
    "@types/node": "^26.6.5",
    "eslint": "^10.12.0",
    "typescript": "^6.0.3",
    "wrangler": "^4.149.0"
  }
}
