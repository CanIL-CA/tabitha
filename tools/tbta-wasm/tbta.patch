diff --git a/TbtaLib/src/StringSourceProvider.h b/TbtaLib/src/StringSourceProvider.h
new file mode 100644
index 0000000..bd804eb
--- /dev/null
+++ b/TbtaLib/src/StringSourceProvider.h
@@ -0,0 +1,19 @@
+#pragma once
+
+#include "SourceProvider.h"
+
+// Supplies encodings handed in by the caller instead of reading Bible.sqlite or fetching them.
+// The requested verse gets m_strCurrent; any other verse (the engine asks for the previous one
+// when m_bIncludePreviousVerse is set) gets m_strPrevious.
+class StringSourceProvider final: public SourceProvider
+{
+public:
+	static inline CString m_strCurrent;
+	static inline CString m_strPrevious;
+	static inline AbsoluteVerseReference m_oCurrentReference;
+
+	CString GetEncodedVerse(CTA1Doc* pDoc, const AbsoluteVerseReference& oVerseReference, bool bPristine) override
+	{
+		return oVerseReference == m_oCurrentReference ? m_strCurrent : m_strPrevious;
+	}
+};
