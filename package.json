{
  "name": "tabitha-monorepo",
  "version": "1.0.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "packageManager": "bun@1.4.0",
  "workspaces": ["apps/*", "packages/*", "tools/*", "scripts"],
  "trustedDependencies": ["@google/genai", "esbuild", "protobufjs", "workerd"],
  "scripts": {
    "dev": "bun scripts/dx/dev_multi.ts",
    "dev:menu": "bun scripts/dx/dev_menu.ts",
    "dev:copilot": "bun --filter @tabitha/copilot dev",
    "dev:editor": "bun --filter @tabitha/editor dev",
    "dev:ontology": "bun --filter @tabitha/ontology dev",
    "dev:scheduler": "bun --filter @tabitha/scheduler dev",
    "dev:sources": "bun --filter @tabitha/sources dev",
    "dev:targets": "bun --filter @tabitha/targets dev",
    "dev:www": "bun --filter @tabitha/www dev",
    "doctor": "bun scripts/dx/doctor.ts",
    "gen:favicons": "bun scripts/dx/generate_favicons.ts",
    "gen:manifest-icons": "bun scripts/dx/generate_manifest_icons.ts",
    "setup": "bun scripts/dx/setup.ts",
    "setup:env": "bun scripts/dx/setup_env.ts",
    "db:status": "bun scripts/dx/db_status.ts",
    "db:load": "bun --filter @tabitha/databases r2:pull -- snapshots && bun scripts/dx/db_load.ts all",
    "db:load:ontology": "bun --filter @tabitha/databases r2:pull -- snapshots && bun scripts/dx/db_load.ts ontology",
    "db:load:sources": "bun --filter @tabitha/databases r2:pull -- snapshots && bun scripts/dx/db_load.ts sources",
    "db:load:targets": "bun --filter @tabitha/databases r2:pull -- snapshots && bun scripts/dx/db_load.ts targets",
    "db:grant": "bun scripts/dx/grant_permission.ts",
    "r2:load": "bun scripts/dx/r2_load.ts",
    "build": "turbo run build",
    "build:ci": "turbo run build:ci",
    "ci": "bun scripts/ci/plan.ts --run",
    "ci:plan": "bun scripts/ci/plan.ts",
    "precommit": "bun run check && bun run check:lint && bun run test && bun run build",
    "check": "turbo run check",
    "check:audits": "bun scripts/audits/run.ts",
    "check:deps": "bun scripts/audits/check_missing_bin_deps.ts",
    "check:cross-platform": "bun scripts/audits/check_cross_platform.ts",
    "check:github-actions": "bun scripts/audits/check_github_actions.ts",
    "check:package-boundaries": "bun scripts/audits/check_relative_package_imports.ts",
    "check:doctor": "bun scripts/dx/doctor.ts",
    "check:philosophies": "bun scripts/audits/check_philosophies.ts",
    "check:a11y-names": "bun scripts/audits/check_accessible_name_collisions.ts",
    "check:noindex": "bun scripts/audits/check_noindex.ts",
    "check:philosophy-docs": "bun scripts/audits/check_philosophy_count_sync.ts",
    "sync:philosophy-docs": "bun scripts/audits/check_philosophy_count_sync.ts --fix",
    "check:secrets": "bun scripts/audits/check_secrets.ts",
    "check:cloudflare": "bun scripts/audits/check_cloudflare.ts",
    "check:storage": "bun scripts/audits/check_storage.ts",
    "check:badges": "bun scripts/audits/check_readme_badges.ts",
    "sync:badges": "bun scripts/audits/check_readme_badges.ts --fix",
    "check:md": "markdownlint-cli2 '**/*.md'",
    "deps:lint": "syncpack lint",
    "deps:fix": "syncpack fix",
    "check:svelte": "turbo run check:svelte",
    "check:lint": "turbo run check:lint",
    "check:lint:fix": "turbo run check:lint:fix",
    "test": "turbo run test",
    "test:unit": "turbo run test:unit",
    "test:coverage": "bun scripts/ci/report_coverage.ts",
    "test:e2e": "bun scripts/ci/run_e2e.ts",
    "test:e2e:install": "bunx playwright install --with-deps chromium",
    "clean:svelte": "turbo run clean:svelte",
    "clean:deps": "turbo run clean:deps && rm -rf node_modules",
    "clean:powerwash": "bun run clean:svelte && bun run clean:deps && bun install",
    "update:safe": "bun scripts/dx/update_safe.ts",
    "update:interactive": "bun update --interactive --latest --recursive"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@vitest/coverage-v8": "^5.0.3",
    "markdownlint-cli2": "^0.23.3",
    "sharp": "^0.35.5",
    "syncpack": "^15.3.3",
    "turbo": "^2.11.7"
  }
}