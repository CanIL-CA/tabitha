# Dependencies
node_modules

# SvelteKit & Vite
.svelte-kit
dist
build

# vite-plugin-pwa dev-mode service worker output
dev-dist

# Paraglide i18n compiler output (see @tabitha/vite-config/paraglide)
**/src/lib/paraglide/

# Cloudflare
.wrangler

# Turborepo
.turbo

# Environment variables -- .env itself is a committed template (public vars + empty secret
# stubs); only the .local variants (which hold real secret values) are gitignored.
.env.local
# plain Workers' conventional local-secrets file (e.g. apps/scheduler), in case one is ever created;
# this repo's convention is .env + .env.local instead, which wrangler also reads
.dev.vars*
.env.*.local
*.local

# Testing & Coverage
test-results/
playwright-report/
blob-report/
playwright/.cache/
coverage/
coverage-baseline/
**/e2e/.auth/

# OS & Logs
.DS_Store
*.log

# Database WAL / SHM
*.sqlite-shm
*.sqlite-wal

# Local cache of Miniflare's resolved D1 storage file names (see scripts/dx/db_load.ts) --
# derived from the local .wrangler state dir, not portable/meaningful across machines
tools/databases/.d1-workerd-hash-cache.json

# ETL migration source data and SQL snapshot dumps -- fetched from the db-migration-data R2 bucket
# (see tools/databases/migrations/r2_sync.ts) rather than committed to git. manifest.json (which
# files currently exist) stays tracked; the actual file contents don't.
tools/databases/raw/*
tools/databases/snapshots/*
!tools/databases/raw/.gitkeep
!tools/databases/snapshots/.gitkeep

# Claude Code -- per-session worktrees and personal permission overrides, not shared config
.claude/worktrees/
.claude/settings.local.json
