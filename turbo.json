{
  "$schema": "https://v2-10-11.turborepo.dev/schema.json",
  "agentGuidance": false,
  "tasks": {
    "prepare": {
      "inputs": [
        "src/app.html",
        "src/routes/**",
        "src/env.ts",
        "src/params.ts",
        "package.json",
        "vite.config.*"
      ],
      "outputs": [".svelte-kit/**"]
    },
    "build": {
      "dependsOn": ["^build", "prepare"],
      "inputs": [
        "src/**",
        "static/**",
        "package.json",
        "tsconfig.json",
        "vite.config.*",
        "wrangler.jsonc"
      ],
      "outputs": [".svelte-kit/**", "dist/**", "build/**"]
    },
    "build:ci": {
      "dependsOn": ["^build", "prepare"],
      "inputs": [
        "src/**",
        "static/**",
        "package.json",
        "tsconfig.json",
        "vite.config.*",
        "wrangler.jsonc"
      ],
      "outputs": [".svelte-kit/**", "dist/**", "build/**"]
    },
    "build:preview": {
      "dependsOn": ["^build", "prepare"],
      "inputs": [
        "src/**",
        "static/**",
        "package.json",
        "tsconfig.json",
        "vite.config.*",
        "wrangler.jsonc"
      ],
      "outputs": [".svelte-kit/**", "dist/**", "build/**"]
    },
    "deploy:preview": {
      "dependsOn": ["build:preview"],
      "cache": false,
      "passThroughEnv": ["CLOUDFLARE_API_TOKEN", "CLOUDFLARE_ACCOUNT_ID"]
    },
    "check": {
      "dependsOn": [
        "prepare"
      ]
    },
    "check:svelte": {
      "dependsOn": [
        "prepare"
      ],
      "inputs": [
        "src/**",
        "e2e/**",
        "playwright.config.js",
        "vite.config.js",
        "tsconfig.json",
        "worker-configuration.d.ts"
      ]
    },
    "check:lint": {
      "inputs": [
        "src/**",
        "eslint.config.js",
        "package.json"
      ]
    },
    "check:lint:fix": {
      "cache": false
    },
    "check:secrets": {
      "inputs": [
        "src/**",
        "scripts/**",
        "tools/**",
        "apps/**",
        "packages/**",
        "!**/node_modules/**",
        "!**/.svelte-kit/**",
        "!**/.turbo/**"
      ]
    },
    "check:cloudflare": {
      "inputs": [
        "apps/**/wrangler.jsonc",
        "scripts/audits/check_cloudflare.ts"
      ]
    },
    "check:storage": {
      "inputs": [
        "apps/**/src/**",
        "packages/**/src/**",
        "scripts/audits/check_storage.ts"
      ]
    },
    "check:badges": {
      "inputs": [
        "README.md",
        "package.json",
        "scripts/audits/check_readme_badges.ts"
      ]
    },
    "check:md": {
      "inputs": [
        "**/*.md",
        "!**/node_modules/**",
        "!**/.svelte-kit/**",
        "!**/.turbo/**",
        "!**/.wrangler/**",
        "!tmp/**"
      ]
    },
    "check:doctor": {
      "cache": false
    },
    "check:philosophies": {
      "cache": false
    },
    "test": {
      "dependsOn": [
        "test:unit",
        "test:e2e"
      ]
    },
    "test:unit": {
      "inputs": [
        "$TURBO_DEFAULT$",
        "!e2e/**",
        "!playwright.config.*",
        "!**/*.md"
      ]
    },
    "test:coverage": {
      "inputs": [
        "src/**",
        "vitest.config.*",
        "package.json"
      ],
      "outputs": [
        "coverage/**"
      ]
    },
    "test:e2e": {
      "dependsOn": [
        "prepare"
      ],
      "env": [
        "E2E_COVERAGE"
      ],
      "outputs": [
        "coverage/e2e/**"
      ],
      "inputs": [
        "src/**",
        "e2e/**",
        "playwright.config.*",
        "package.json"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "dev:e2e": {
      "cache": false,
      "persistent": true
    },
    "clean:svelte": {
      "cache": false
    },
    "clean:deps": {
      "cache": false
    }
  }
}
