{
  "config": {
    "default": true,
    "MD013": false,
    "MD024": {
      "siblings_only": true
    },
    "MD033": false
  },
  "ignores": [
    "**/node_modules/**",
    "**/.svelte-kit/**",
    "**/.turbo/**",
    "**/.wrangler/**",
    // Generated output, gitignored like the entries above: `wrangler deploy --dry-run --outdir dist`
    // copies an app's README into dist/, failed Playwright runs leave error-context.md files, and
    // `bun run test:coverage` writes the PR comment's table to coverage/report.md.
    "**/dist/**",
    "**/test-results/**",
    "coverage/**",
    "tmp/**",
    // inlang writes its own README (and .gitignore, which ignores everything but settings.json)
    // into each app's project.inlang/.
    "**/*.inlang/**",
    "**/src/lib/paraglide/**",
    // Vendored skill reference docs, not this repo's own authored content -- not worth
    // reformatting to our lint rules.
    ".claude/skills/**"
  ]
}
